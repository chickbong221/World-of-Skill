new file mode 100644
index 0000000..4390dba
--- /dev/null
+++ b/embodied/run/nanwatch.py
@@ -0,0 +1,214 @@
+"""NaN watchdog for offline training.
+
+Keeps the last `window` training steps of scalar metrics in memory (dense, per
+update) while the normal logger stays sparse. On the first non-finite event it
+writes a condensed report plus everything needed to replay the bad step:
+
+  <logdir>/nan_report/
+    summary.txt   condensed diagnosis (also printed)
+    ring.jsonl    last `window` updates, all scalar metrics
+    batch.npz     the batch that produced the bad step (incl. its seed)
+    carry.pkl     the train carry fed into that step
+    spaces.pkl    obs/act spaces (to rebuild the agent)
+    ckpt/         agent state BEFORE the bad update (needs agent.nanguard=freeze)
+
+Replay one step (prints the per-module diagnosis of the replayed step):
+  python methods/MoSS/main.py <same configs/flags> \\
+      --run.nan_replay <logdir>/nan_report
+
+EXPERIMENTAL: adding --jax.precompile False runs the replayed step eagerly
+under jax_debug_nans for an op-level traceback. Known limitation: in eager mode
+stock DreamerV3's return normalizer (embodied/jax/utils.py _perc) raises first,
+for the RSSM baseline as well, before the real NaN is reached.
+
+Metrics returned by agent.train() lag one call (they are fetched async), so the
+metrics seen at call i belong to the batch fed at call i-1. References to the
+last two inputs are kept; batch, seed and carry are not donated by the jitted
+train step, so holding them costs no host sync.
+"""
+
+import collections
+import json
+import math
+import pickle
+
+import elements
+import jax
+import numpy as np
+
+
+TREND_KEYS = ('opt/loss', 'opt/grad_norm', 'opt/grad_nonfinite',
+              'moss_eff_experts', 'moss_dead_experts', 'moss_load_max',
+              'moss_active_mass', 'moss_lambda')
+
+
+def _scalars(mets):
+  out = {}
+  for k, v in mets.items():
+    try:
+      a = np.asarray(v)
+    except Exception:
+      continue
+    if a.size == 1 and np.issubdtype(a.dtype, np.number):
+      out[k] = float(a.reshape(()))
+  return out
+
+
+def _bad(x):
+  return not math.isfinite(x)
+
+
+class NanWatch:
+
+  def __init__(self, logdir, window=100, stop=True):
+    self.outdir = elements.Path(logdir) / 'nan_report'
+    self.ring = collections.deque(maxlen=int(window))
+    self.inputs = collections.deque(maxlen=2)
+    self.stop = bool(stop)
+    self.triggered = False
+    self.updates = 0
+
+  def before(self, batch, carry):
+    # Shallow copy: agent.train() pops 'seed' from the dict it receives.
+    self.inputs.append((dict(batch), carry))
+
+  def after(self, mets, step):
+    """Record metrics of the PREVIOUS call; return True on the first NaN."""
+    row = _scalars(mets)
+    if not row:
+      return False
+    self.updates += 1
+    row = {'update': self.updates, 'step': int(step), **row}
+    self.ring.append(row)
+    if self.triggered:
+      return False
+    bad = [k for k, v in row.items() if _bad(v)]
+    flagged = (row.get('opt/skipped', 0) > 0 or
+               row.get('opt/grad_nonfinite', 0) > 0 or
+               row.get('opt/param_nonfinite', 0) > 0)
+    if bad or flagged:
+      self.triggered = True
+      return True
+    return False
+
+  # ------------------------------------------------------------------ dump
+
+  def diagnose(self):
+    rows = list(self.ring)
+    last = rows[-1]
+    bad = sorted(k for k, v in last.items() if _bad(v))
+    losses_bad = [k for k in bad if '/loss/' in k or k.startswith('loss/')
+                  or k.endswith('opt/loss')]
+    if last.get('opt/param_nonfinite', 0) > 0:
+      cat = ('PARAMS already non-finite before this step: the NaN entered '
+             'earlier. Enable --agent.nanguard freeze to stop at the origin.')
+    elif losses_bad:
+      cat = 'FORWARD: a loss value is non-finite ' + str(losses_bad)
+    else:
+      cat = ('BACKWARD: every loss value is finite but the gradient is not '
+             '(e.g. norm/sqrt/log of 0, or 0 * inf inside a jnp.where)')
+    gbad = sorted(((v, k[len('opt/gbad/'):]) for k, v in last.items()
+                   if k.startswith('opt/gbad/') and v > 0), reverse=True)
+    lines = [
+        '=' * 72,
+        f'NaN WATCHDOG  update {last["update"]}  (agent step {last["step"]})',
+        '=' * 72,
+        f'category : {cat}',
+        f'frozen   : {bool(last.get("opt/frozen", 0))}  '
+        f'(replayable checkpoint: {"yes" if last.get("opt/frozen", 0) else "no"})',
+        f'non-finite metrics ({len(bad)}): ' + ', '.join(bad[:25]),
+    ]
+    if gbad:
+      lines.append('modules with non-finite gradients (count): ' + ', '.join(
+          f'{k}={int(v)}' for v, k in gbad[:12]))
+    elif not any(k.startswith('opt/gbad/') for k in last):
+      lines.append('per-module gradients not logged: enable --agent.grad_diag True')
+    gn = sorted(((v, k[len('opt/gnorm/'):]) for k, v in last.items()
+                 if k.startswith('opt/gnorm/') and math.isfinite(v)),
+                reverse=True)
+    if gn:
+      lines.append('largest finite grad norms: ' + ', '.join(
+          f'{k}={v:.3g}' for v, k in gn[:8]))
+    loss_now = {k.split('loss/')[-1]: v for k, v in last.items()
+                if k.startswith('loss/') or '/loss/' in k}
+    if loss_now:
+      lines.append('losses at bad step: ' + ' | '.join(
+          f'{k}={v:.4g}' for k, v in sorted(loss_now.items())))
+    keys = [k for k in TREND_KEYS if any(k in r for r in rows)]
+    keys += [f'opt/gnorm/{k}' for _, k in gn[:3]]
+    if keys:
+      tail = rows[-10:]
+      lines.append(f'trend over the last {len(tail)} updates:')
+      lines.append('  ' + 'update'.rjust(7) + ''.join(
+          k.split('/')[-1][:12].rjust(13) for k in keys))
+      for r in tail:
+        lines.append('  ' + str(r['update']).rjust(7) + ''.join(
+            (f'{r[k]:.4g}' if k in r else '-').rjust(13) for k in keys))
+    lines.append(f'full window ({len(rows)} updates): {self.outdir}/ring.jsonl')
+    return '\n'.join(lines)
+
+  def dump(self, agent, obs_space, act_space):
+    self.outdir.mkdir()
+    rows = list(self.ring)
+    with (self.outdir / 'ring.jsonl').open('w') as f:
+      for r in rows:
+        f.write(json.dumps(r) + '\n')
+    summary = self.diagnose()
+    (self.outdir / 'summary.txt').write(summary + '\n')
+    print(summary)
+    if len(self.inputs) == 2:
+      batch, carry = self.inputs[0]                  # input of the bad step
+      host = {k: np.asarray(v) for k, v in batch.items()}
+      with (self.outdir / 'batch.npz').open('wb') as f:
+        np.savez(f, **host)
+      with (self.outdir / 'carry.pkl').open('wb') as f:
+        pickle.dump(jax.tree.map(np.asarray, carry), f)
+    with (self.outdir / 'spaces.pkl').open('wb') as f:
+      pickle.dump((dict(obs_space), dict(act_space)), f)
+    if rows and rows[-1].get('opt/frozen', 0):
+      cp = elements.Checkpoint(self.outdir / 'ckpt')
+      cp.agent = agent
+      cp.save()
+      print(f'[nanwatch] replayable state saved to {self.outdir}')
+    else:
+      print('[nanwatch] parameters may already be non-finite; no checkpoint '
+            'saved. Re-run with --agent.nanguard freeze to make it replayable.')
+
+
+def replay(agent, nandir, batch_size):
+  """Re-run the saved bad step once; print the diagnosis of its metrics."""
+  nandir = elements.Path(nandir)
+  cp = elements.Checkpoint(nandir / 'ckpt')
+  cp.agent = agent
+  cp.load()
+  with (nandir / 'batch.npz').open('rb') as f:
+    data = dict(np.load(f))
+  seed = data.pop('seed')
+  with (nandir / 'carry.pkl').open('rb') as f:
+    saved_carry = pickle.load(f)
+  dev = next(iter(agent.stream(iter([data]))))
+  dev['seed'] = jax.device_put(seed, dev['seed'].sharding)
+  carry = agent.init_train(batch_size)
+  carry = jax.tree.map(
+      lambda ref, x: jax.device_put(np.asarray(x, ref.dtype), ref.sharding),
+      carry, saved_carry)
+  if getattr(agent, 'jaxcfg', None) is not None and agent.jaxcfg.precompile:
+    print('[nan_replay] train step is AOT-compiled: NaNs are reported per '
+          'step only. Add --jax.precompile False to locate the exact op.')
+  else:
+    # Only now: building the agent itself evaluates a dummy batch whose
+    # outputs can be NaN (stock DreamerV3, harmless), which debug_nans
+    # would report. Eager mode gives an op-level traceback; implicit
+    # host<->device transfers are then needed, so lift the transfer guard.
+    jax.config.update('jax_debug_nans', True)
+    jax.config.update('jax_disable_jit', True)
+    jax.config.update('jax_transfer_guard', 'allow')
+  print('[nan_replay] re-running the saved step')
+  # train() pops 'seed' from its input, so pass copies.
+  carry, _, _ = agent.train(carry, dict(dev))
+  _, _, mets = agent.train(carry, dict(dev))          # fetch lagged metrics
+  watch = NanWatch(nandir.parent, window=1)
+  watch.outdir = nandir / 'replay'
+  watch.after(mets, step=0)
+  print(watch.diagnose())
+  return mets
