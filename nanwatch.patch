+_EXPERT = re.compile(r'^e(\d+)(in|innorm|hid\d+|hid\d+norm|gru)$')
+_STATS = ('q_ema', 'l_ema', 'count', 'eseen', 'dbar', 'step')
+_ALIAS = {'priorlogit': 'prior', 'obslogit': 'obs', 'rlogit': 'router',
