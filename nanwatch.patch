+
+def _group(key):
+  """'dyn/e3gru/kernel' -> 'dyn/e3', 'dyn/prior0norm/scale' -> 'dyn/prior'."""
+  parts = key.split('/')
+  if parts[0] != 'dyn' or len(parts) < 3:
+    return parts[0]
+  sub = parts[1]
+  m = _EXPERT.match(sub)
+  if m:
+    return f'dyn/e{m.group(1)}'
+  if sub in _STATS:
+    return 'dyn/stats'
+  base = re.sub(r'\d*(norm)?$', '', sub)
+  return 'dyn/' + _ALIAS.get(base, base)
