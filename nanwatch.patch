+  groups = {}
+  for k in grads:
+    groups.setdefault(_group(k), []).append(k)
+  out, total_bad = {}, 0.0
+  for g, keys in sorted(groups.items()):
+    sq = sum(jnp.sum(jnp.square(f32(grads[k]))) for k in keys)
+    bad = sum(jnp.sum(f32(~jnp.isfinite(grads[k]))) for k in keys)
+    out[f'gnorm/{g}'] = jnp.sqrt(sq)
+    out[f'gbad/{g}'] = bad
+    total_bad = total_bad + bad
+  out['grad_nonfinite'] = total_bad
+  out['param_nonfinite'] = sum(
+      jnp.sum(f32(~jnp.isfinite(v))) for v in params.values()
+      if jnp.issubdtype(v.dtype, jnp.floating))
+  return out
