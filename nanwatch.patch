+"""End-to-end test of the NaN guard + watchdog + replay on the real MoSS agent.
+
+  JAX_PLATFORMS=cpu python tests_nanwatch.py grad   # finite loss, NaN gradient
+  JAX_PLATFORMS=cpu python tests_nanwatch.py fwd    # NaN loss value
+
+A NaN is injected at MoSS step AT, then checks that: the guard skips and
+freezes (parameters identical to before the bad step), the watchdog classifies
+it (BACKWARD / FORWARD), dumps ring/batch/carry/ckpt, and (grad mode) a fresh
+agent replaying the dump with jax.debug_nans raises at the injected op.
+"""
+import sys
+import traceback
+sys.path.insert(0, '.')
+
+import elements
+import jax.numpy as jnp
+import numpy as np
+import ruamel.yaml as yaml
+
+from embodied.run import nanwatch
+from methods.MoSS import main as mmain
+import importlib
+# main.py sets __package__ = 'MoSS', so the agent imports 'MoSS.moss':
+# patch THAT module (patching methods.MoSS.moss would have no effect).
+moss = importlib.import_module(mmain.__package__ + '.moss')
+
+MODE, AT = sys.argv[1], 4
+INJ = 'fwd' if MODE == 'fwd' else 'grad'     # 'replay' re-runs the grad case
+B, T, NTASK, OBS, ACT = 2, 16, 3, 93, 8
+LOGDIR = f'/tmp/nanwatch_{INJ}'
+
+orig = moss.MoSSRSSM.loss
+def patched(self, *a, **k):
+  carry, entries, losses, feat, mets = orig(self, *a, **k)
+  bad = self.step.read() >= AT
+  x = jnp.float32(feat['deter']).mean()
+  if INJ == 'grad':
+    v = jnp.where(bad, jnp.zeros(3), jnp.ones(3)) * x
+    losses['mdiv'] = losses['mdiv'] + 0.0 * jnp.linalg.norm(v)  # INJECTED_GRAD_NAN
+  else:
+    losses['mdiv'] = losses['mdiv'] + jnp.where(bad, jnp.nan, 0.0)  # INJECTED_FWD_NAN
+  return carry, entries, losses, feat, mets
+moss.MoSSRSSM.loss = patched
+
+
+def build(debug_nans=False, jit=True, precompile=True):
+  configs = yaml.YAML(typ='safe').load(
+      elements.Path('methods/MoSS/configs.yaml').read())
+  config = elements.Config(configs['defaults'])
+  for name in ['offline_comp', 'offline_comp_moss', 'size1m', 'nandebug']:
+    config = config.update(configs[name])
+  config = config.update({
+      'logdir': LOGDIR, 'batch_size': B, 'batch_length': T,
+      'report_length': 4, 'replay_context': 0,
+      'jax.platform': 'cpu', 'jax.prealloc': False,
+      'jax.debug_nans': debug_nans, 'jax.jit': jit,
+      'jax.precompile': precompile, 'agent.imag_length': 3,
+      'agent.dyn.moss.deter': 64, 'agent.dyn.moss.hidden': 32,
+      'agent.dyn.moss.stoch': 4, 'agent.dyn.moss.classes': 4,
+      'agent.dyn.moss.blocks': 4, 'agent.dyn.moss.experts': 4,
+      'agent.dyn.moss.zdim': 16, 'agent.dyn.moss.nmin': 1,
+      'agent.dyn.moss.nsig': 2, 'agent.dyn.moss.maxsig': 8,
+  })
+  obs_space = {
+      'vector': elements.Space(np.float32, (OBS,)),
+      'reward': elements.Space(np.float32),
+      'is_first': elements.Space(bool), 'is_last': elements.Space(bool),
+      'is_terminal': elements.Space(bool),
+      'task_id': elements.Space(np.int32, (), 0, NTASK),
+      'task_axes': elements.Space(np.int32, (4,), 0, 4),
+  }
+  act_space = {'action': elements.Space(np.float32, (ACT,), -1, 1)}
+  return mmain.make_agent(config, obs_space, act_space), obs_space, act_space
+
+
+rng = np.random.default_rng(0)
+def batch():
+  first = np.zeros((B, T), bool); first[:, 0] = True
+  return {
+      'vector': rng.normal(size=(B, T, OBS)).astype(np.float32),
+      'reward': rng.uniform(size=(B, T)).astype(np.float32),
+      'is_first': first, 'is_last': np.zeros((B, T), bool),
+      'is_terminal': np.zeros((B, T), bool),
+      'task_id': np.repeat(np.arange(B) % NTASK, T).reshape(B, T).astype(np.int32),
+      'task_axes': rng.integers(0, 4, (B, T, 4)).astype(np.int32),
+      'action': rng.uniform(-1, 1, (B, T, ACT)).astype(np.float32),
+      'consec': np.zeros((B, T), np.int32),
+      'stepid': rng.integers(0, 255, (B, T, 20)).astype(np.uint8),
+  }
+
+if MODE == 'replay':          # separate process, like --run.nan_replay
+  agent2, _, _ = build(precompile=False)
+  nanwatch.replay(agent2, f'{LOGDIR}/nan_report', B)
+  raise SystemExit('replay finished WITHOUT raising')
+
+agent, obs_space, act_space = build()
+watch = nanwatch.NanWatch(LOGDIR, window=100, stop=True)
+stream = iter(agent.stream(iter([batch() for _ in range(12)])))
+carry = agent.init_train(B)
+KEY = 'dyn/e0gru/kernel'
+snaps = []
+for call in range(10):
+  snaps.append(np.asarray(agent.params[KEY]).copy())  # host copy before call
+  data = next(stream)
+  watch.before(data, carry)
+  carry, outs, mets = agent.train(carry, data)
+  if watch.after(mets, step=call):
+    bad_call = call - 1                                # metrics lag one call
+    watch.dump(agent, obs_space, act_space)
+    break
+else:
+  raise AssertionError('watchdog never triggered')
+
+now = np.asarray(agent.params[KEY])
+print(f'\n[check] bad step = call {bad_call}; params frozen at pre-bad values: '
+      f'{np.array_equal(now, snaps[bad_call])} (changed before it: '
+      f'{not np.array_equal(snaps[bad_call], snaps[0])})')
+assert np.array_equal(now, snaps[bad_call]), 'freeze failed'
+assert np.isfinite(now).all()
+summary = (watch.outdir / 'summary.txt').read()
+want = 'BACKWARD' if MODE == 'grad' else 'FORWARD'
+assert want in summary, f'expected {want} classification'
+files = sorted(p.name for p in watch.outdir.glob('*'))
+print('[check] classification:', want, '| dumped:', files)
+for f in ('summary.txt', 'ring.jsonl', 'batch.npz', 'carry.pkl', 'spaces.pkl', 'ckpt'):
+  assert f in files, f
+nrows = len((watch.outdir / 'ring.jsonl').read().strip().splitlines())
+print(f'[check] ring.jsonl rows: {nrows}')
+
+if MODE == 'grad':
+  import os, subprocess
+  res = subprocess.run([sys.executable, __file__, 'replay'], capture_output=True,
+                       text=True, env={**os.environ, 'JAX_PLATFORMS': 'cpu'})
+  out = res.stdout + res.stderr
+  # Must come from the REPLAYED step, not from agent construction.
+  after = out.split('[nan_replay]', 1)[1] if '[nan_replay]' in out else ''
+  raised = 'FloatingPointError' in after
+  print(f'[check] eager replay raised FloatingPointError: {raised}; '
+        f'traceback names injected line: {"INJECTED_GRAD_NAN" in after}')
+  for line in after.splitlines():
+    if ('FloatingPointError' in line or 'INJECTED' in line or
+        'tests_nanwatch.py' in line or 'moss.py' in line):
+      print('   ', line.strip()[:160])
+  assert raised, out[-3000:]
+print(f'\nNANWATCH TEST OK ({MODE})')
